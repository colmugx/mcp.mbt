import {
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/fs",
}

fn walk(root : String, prefix : String, files : Array[String]) -> Unit raise {
  let entries = @fs.read_dir(root + (if prefix.is_empty() { "" } else { "/" + prefix })).to_owned()
  entries.sort()
  for entry in entries {
    let relative = if prefix.is_empty() { entry } else { prefix + "/" + entry }
    if @fs.is_dir(root + "/" + relative) { walk(root, relative, files) }
    else if relative.has_suffix(".json") { files.push(relative) }
  }
}

fn main raise {
  guard @json.parse(@fs.read_file_to_string("benchmarks/suite.json")) is Object(config) else { fail("invalid suite configuration") }
  guard config.get("revision") is Some(String(revision)) && config.get("source") is Some(String(source)) && config.get("manifest") is Some(String(destination)) else { fail("missing suite configuration") }
  guard @json.parse(@fs.read_file_to_string("benchmark-results/suite-source.json")) is Object(verified) && verified.get("revision") == Some(Json::string(revision)) else { fail("run fetch-suite.mbtx to verify the corpus first") }
  let root = source + "/tests/draft2020-12"
  let paths : Array[String] = []
  walk(root, "", paths)
  guard !paths.is_empty() else { fail("empty official corpus") }
  let totals : Map[String, Int] = { "standard": 0, "optional": 0, "proposal": 0 }
  let entries : Array[Json] = []
  for path in paths {
    // This AST is used only for metadata counts. The original fixture is
    // untouched and the native runner reparses it with preserved lexemes.
    guard @json.parse(@fs.read_file_to_string(root + "/" + path)) is Array(groups) else { fail("not a test group array: " + path) }
    let category = if path.has_prefix("optional/") { "optional" } else if path.has_prefix("proposals/") { "proposal" } else { "standard" }
    let mut tests = 0
    for group in groups {
      guard group is Object(fields) && fields.get("tests") is Some(Array(cases)) && fields.get("schema") is Some(_) && fields.get("description") is Some(String(_)) else { fail("malformed test group: " + path) }
      for instance in cases {
        guard instance is Object(test_fields) && test_fields.get("data") is Some(_) && test_fields.get("description") is Some(String(_)) && (test_fields.get("valid") == Some(Json::boolean(true)) || test_fields.get("valid") == Some(Json::boolean(false))) else { fail("malformed instance: " + path) }
      }
      tests += cases.length()
    }
    totals[category] = totals[category] + tests
    entries.push({ "path": path, "category": category, "groups": groups.length(), "tests": tests })
  }
  guard totals["standard"] > 0 else { fail("no standard cases") }
  let remote_paths : Array[String] = []
  walk(source + "/remotes", "", remote_paths)
  let remotes = remote_paths.map(path => ({ "uri": "http://localhost:1234/" + path, "path": source + "/remotes/" + path } : Json))
  let manifest : Json = { "version": 1, "revision": revision, "suite_root": root, "files": Json::array(entries), "totals": totals.to_json(), "remotes": Json::array(remotes) }
  @fs.write_string_to_file(destination, manifest.stringify(indent=2))
  println("standard: \{totals["standard"]}; optional: \{totals["optional"]}; proposals: \{totals["proposal"]}; files: \{paths.length()}; remotes: \{remote_paths.length()}")
}
