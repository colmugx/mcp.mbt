import {
  "colmugx/mcp/protocol/types",
  "colmugx/mcp/transport",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/async",
  "moonbitlang/core/async/http",
  "moonbitlang/core/async/io",
}

import {
  "moonbitlang/core/debug",
  "moonbitlang/core/async",
  "moonbitlang/core/async/socket",
} for "wbtest"

// http_session relies on @http streaming APIs, which moonbitlang/core/async ships
// only for native+wasm (client.mbt) and js (client.js.mbt); they are absent
// under wasm-gc, so the file is gated out there.
// unused_package is noise for gated packages and cannot be suppressed
// per-target or per-file (same rationale as src/transport).

warnings = "-unused_package"

options(
  "allow-experimental-packages": true,
  targets: {
    "http_session.mbt": [ "native", "js", "wasm" ],
    "unimplemented.mbt": [ "wasm-gc" ],
    "http_cancellation_e2e_wbtest.mbt": [ "native" ],
    "legacy_client_logic_wbtest.mbt": [ "native", "js", "wasm" ],
    "legacy_client_js_stdio_e2e_wbtest.mbt": [ "js" ],
  },
)
