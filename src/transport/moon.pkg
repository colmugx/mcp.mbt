import {
  "colmugx/mcp/protocol/types",
  "colmugx/mcp/runtime",
  "colmugx/mcp/validation",
  "gmlewis/base64",
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/lexbuf",
  "moonbitlang/core/async/stdio",
  "moonbitlang/core/async/http",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/async/process",
  "moonbitlang/core/async",
  "moonbitlang/core/async/io",
  "moonbitlang/core/async/js_async",
}

import {
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/quickcheck" @qc,
} for "test"

import {
  "moonbitlang/core/debug",
  "moonbitlang/core/quickcheck" @qc,
  "moonbitlang/core/async/js_async",
} for "wbtest"

// js/wasm-gc gate out the I/O source files, so their imports (stdio/socket/
// process) are unused on those targets; unused_package is noise for gated
// packages and cannot be suppressed per-target or per-file.

warnings = "-unused_package"

// http_client/sse rely on @http.Client streaming APIs, which moonbitlang/
// async ships only for native+wasm (client.mbt) and js (client.js.mbt); they
// are absent under wasm-gc, where unimplemented.mbt provides abort stubs.

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async/stdio",
    "moonbitlang/core/async/http",
    "moonbitlang/core/async/socket",
    "moonbitlang/core/async/process",
    "moonbitlang/core/async",
    "moonbitlang/core/async/io",
    "moonbitlang/core/async/js_async",
  ],
  targets: {
    "unimplemented.mbt": [ "wasm-gc" ],
    "unimplemented_js.mbt": [ "js" ],
    "stdio.mbt": [ "native", "wasm" ],
    "stdio_client.mbt": [ "native", "wasm" ],
    "stdio_client_js.mbt": [ "js" ],
    "stdio_client_js_e2e_wbtest.mbt": [ "js" ],
    "stdio_frame_e2e_test.mbt": [ "native", "js" ],
    "http_server.mbt": [ "native", "wasm" ],
    "http_status.mbt": [ "native", "wasm" ],
    "http_status_wbtest.mbt": [ "native", "wasm" ],
    "http_client.mbt": [ "native", "js", "wasm" ],
    "cancellation.mbt": [ "native", "js", "wasm" ],
    "http_client_lifecycle_wbtest.mbt": [ "native", "js", "wasm" ],
    "sse.mbt": [ "native", "js", "wasm" ],
    "sse_wbtest.mbt": [ "native", "js", "wasm" ],
    "http_compliance_test.mbt": [ "native", "js", "wasm" ],
    "transport_io_test.mbt": [ "native", "wasm" ],
    "http_compliance_e2e_test.mbt": [ "native", "wasm" ],
    "sse_flush_e2e_test.mbt": [ "native" ],
    "http_cancellation_e2e_test.mbt": [ "native" ],
    "http_request_id_e2e_test.mbt": [ "native" ],
  },
)
