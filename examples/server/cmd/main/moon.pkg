import {
  "colmugx/mcp",
  "colmugx/mcp/server",
  "moonbitlang/core/async",
}

pkgtype(kind: "executable")

// Native CLI example; async runtime entry points are unavailable outside
// native/js/wasm and the CLI is only exercised on native.

supported_targets = "native"

options("allow-experimental-packages": ["moonbitlang/core/async"])
